<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="splash_bg">#FF06080B</color>

    <style name="Theme.Rumo" parent="android:Theme.Material.NoActionBar">
        <!-- Fundo da janela = tela de abertura, mostrada antes do primeiro quadro do Compose -->
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:colorBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:colorAccent">#FFFFB020</item>
    </style>
</resources>
